CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // main memory
    Not(in=address[14], out=ramSelect);
    And(a=ramSelect, b=load, out=ramLoad);
    RAM16K(in= in, load= ramLoad, address=address[0..13], out= outMem);

    // screen memmap
    Not(in=address[13],out=notScreenMap);
    And(a=address[14], b=notScreenMap,out=screenSelect);
    And(a=screenSelect, b=load, out=screenLoad);
    Screen(in=in, load=screenLoad, address=address[0..12], out=outScreen);

    // keyboard
    Keyboard(out=outKeyboard);

    // select and send to out
    Mux16(a=outScreen,b=outMem,sel=address[14],out=outMemScreen);
    And(a=address[14], b = address[13], out=andKeySel);
    Mux16(a=outMemScreen, b=outKeyboard, sel = andKeySel);


}
